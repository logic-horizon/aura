{
  "name": "@bunkernineai/aura-cli",
  "version": "0.1.0-beta.0",
  "description": "Taste memory CLI and self-hosted server. Train markdown, store locally or on an Aura cloud, serve it over MCP.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Sheikh Sifat",
    "url": "https://github.com/bunkernine"
  },
  "homepage": "https://github.com/bunkernine/aura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunkernine/aura.git"
  },
  "bugs": {
    "url": "https://github.com/bunkernine/aura/issues"
  },
  "keywords": [
    "aura",
    "cli",
    "mcp",
    "taste",
    "memory",
    "embeddings",
    "pgvector",
    "hono",
    "bun"
  ],
  "bin": {
    "aura": "./cli/index.ts"
  },
  "files": [
    "cli",
    "lib",
    "server",
    "drizzle.config.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "aura": "bun run cli/index.ts",
    "server": "bun run server/index.ts",
    "db:push": "bun x drizzle-kit push",
    "prepublishOnly": "bunx tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.1.0"
  }
}
