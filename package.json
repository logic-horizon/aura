{
  "name": "@bunkernineai/aura-cli",
  "version": "0.1.0-beta.0",
  "description": "Local taste memory CLI and hostable HTTP MCP server.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Sheikh Sifat",
    "url": "https://github.com/bunkernine"
  },
  "homepage": "https://github.com/bunkernine/aura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bunkernine/aura.git"
  },
  "bugs": {
    "url": "https://github.com/bunkernine/aura/issues"
  },
  "keywords": [
    "aura",
    "cli",
    "mcp",
    "taste",
    "memory",
    "embeddings",
    "pgvector",
    "hono",
    "bun"
  ],
  "bin": {
    "aura": "./cli/index.ts"
  },
  "files": [
    "cli",
    "mcp",
    "vector",
    "tui",
    "lib",
    "schema",
    "assets",
    "drizzle.config.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "aura": "bun run cli/index.ts",
    "mcp": "bun run mcp/listen.ts",
    "db:push": "bun x drizzle-kit push",
    "test:live": "AURA_LIVE=1 bun test openrouter.live",
    "prepublishOnly": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "@openrouter/sdk": "^1.4.25",
    "@opentui/core": "^0.5.16",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.13.8",
    "localtunnel": "^2.0.2",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.1.0"
  }
}
