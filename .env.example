# Copy to .env when running `aura server`. CLI local-only needs none of these.

# Postgres + pgvector (required for the server, not for local .aura/ store)
DATABASE_URL=

# HTTP
PORT=8787
HOST=127.0.0.1

# Bearer for POST /sync (CLI push) and HTTP MCP
AURA_TOKEN=
MCP_BEARER_TOKEN=

# Optional compiled snapshots via Bun S3Client
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
